{
  "manifest_version": 3,
  "name": "CzGram connector",
  "version": "2.1.0",
  "description": "Lets the CzGram desktop app read the active tab when you press PrintScreen.",
  "key": "",
  "minimum_chrome_version": "110",
  "permissions": [
    "nativeMessaging",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}